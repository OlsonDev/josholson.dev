## Parentheses (drop redundant ones)
dotnet_style_parentheses_in_arithmetic_binary_operators = never_if_unnecessary:warning
dotnet_style_parentheses_in_relational_binary_operators = never_if_unnecessary:warning
dotnet_style_parentheses_in_other_binary_operators = never_if_unnecessary:warning
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:warning

## Modifiers and qualification
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_style_require_accessibility_modifiers = always:warning
dotnet_style_readonly_field = true:warning
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,required,readonly,unsafe,volatile,async:warning

## Naming
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_pascal_case.required_prefix = _
dotnet_naming_style.interface_style.capitalization = pascal_case
dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_style.type_parameter_style.capitalization = pascal_case
dotnet_naming_style.type_parameter_style.required_prefix = T
dotnet_naming_style.async_style.capitalization = pascal_case
dotnet_naming_style.async_style.required_suffix = Async

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interfaces.symbols = interfaces
dotnet_naming_rule.interfaces.style = interface_style
dotnet_naming_rule.interfaces.severity = warning

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_rule.type_parameters.symbols = type_parameters
dotnet_naming_rule.type_parameters.style = type_parameter_style
dotnet_naming_rule.type_parameters.severity = warning

dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static
dotnet_naming_rule.private_static_fields.symbols = private_static_fields
dotnet_naming_rule.private_static_fields.style = underscore_pascal_case
dotnet_naming_rule.private_static_fields.severity = warning

dotnet_naming_symbols.private_const_fields.applicable_kinds = field
dotnet_naming_symbols.private_const_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_const_fields.required_modifiers = const
dotnet_naming_rule.private_const_fields.symbols = private_const_fields
dotnet_naming_rule.private_const_fields.style = underscore_pascal_case
dotnet_naming_rule.private_const_fields.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel_case
dotnet_naming_rule.private_fields.severity = warning

dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_rule.async_methods.symbols = async_methods
dotnet_naming_rule.async_methods.style = async_style
dotnet_naming_rule.async_methods.severity = warning

dotnet_naming_symbols.local_functions.applicable_kinds = local_function
dotnet_naming_rule.local_functions.symbols = local_functions
dotnet_naming_rule.local_functions.style = pascal_case
dotnet_naming_rule.local_functions.severity = warning

dotnet_naming_symbols.pascal_members.applicable_kinds = class, struct, enum, delegate, method, property, event, field, namespace
dotnet_naming_symbols.pascal_members.applicable_accessibilities = public, internal, protected, protected_internal, private_protected
dotnet_naming_rule.pascal_members.symbols = pascal_members
dotnet_naming_rule.pascal_members.style = pascal_case
dotnet_naming_rule.pascal_members.severity = warning

dotnet_naming_symbols.local_constants.applicable_kinds = local
dotnet_naming_symbols.local_constants.required_modifiers = const
dotnet_naming_rule.local_constants.symbols = local_constants
dotnet_naming_rule.local_constants.style = pascal_case
dotnet_naming_rule.local_constants.severity = warning

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter
dotnet_naming_rule.locals_and_parameters.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters.style = camel_case
dotnet_naming_rule.locals_and_parameters.severity = warning

# Test methods are named for the behavior, not with an Async suffix
[*.Tests.cs]
dotnet_naming_rule.async_methods.severity = none

# Public controller actions are named for the route; MVC strips an Async suffix from action names anyway
[*Controller.cs]
dotnet_naming_symbols.public_async_methods.applicable_kinds = method
dotnet_naming_symbols.public_async_methods.applicable_accessibilities = public
dotnet_naming_symbols.public_async_methods.required_modifiers = async
dotnet_naming_rule.public_async_methods.symbols = public_async_methods
dotnet_naming_rule.public_async_methods.style = async_style
dotnet_naming_rule.public_async_methods.severity = none

# A file with several types is {Name}.{Plural}.cs (Tag.Payloads.cs, Domain.Attributes.cs), and tests are Foo.Tests.cs
[*.*s.cs]
dotnet_diagnostic.MA0048.severity = none

# Scripts are file-based apps, so these rules do not fit them:
# - top-level code is a class named Program and hook helpers are kebab-case files (MA0048)
# - helper types sit in the global namespace (MA0047, RCS1110)
# - regexes run over our own files and database, not untrusted input (MA0009, RCS1186)
# - one script is one file, so a long method is a section of it (MA0051)
[{scripts,.githooks}/*.cs]
dotnet_diagnostic.MA0048.severity = none
dotnet_diagnostic.MA0047.severity = none
dotnet_diagnostic.RCS1110.severity = none
dotnet_diagnostic.MA0009.severity = none
dotnet_diagnostic.RCS1186.severity = none
dotnet_diagnostic.MA0051.severity = none
