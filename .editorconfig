dotnet_diagnostic.RCS1253.severity = none
dotnet_diagnostic.RCS1255.severity = none
dotnet_diagnostic.RCS1260.severity = none

## Roslynator.Formatting.Analyzers: only the rules that place a token, since .editorconfig cannot (the rest are off)
roslynator_conditional_operator_new_line = before
roslynator_binary_operator_new_line = before
roslynator_arrow_token_new_line = before
dotnet_diagnostic.RCS0027.severity = warning
dotnet_diagnostic.RCS0028.severity = warning
dotnet_diagnostic.RCS0032.severity = warning
dotnet_diagnostic.RCS0062.severity = warning

