POSTGRES_USER=josholson
POSTGRES_PASSWORD=change-me
POSTGRES_DB=josholson
POSTGRES_PORT=5432
# Password for the DML-only josholson_api role (see database/provisioning/api_role.sql); mise db:provision sets it.
POSTGRES_API_PASSWORD=change-me-too
# Read by `mise api:run`. The API connects as josholson_api, so the password is POSTGRES_API_PASSWORD's.
ConnectionStrings__Default=Host=localhost;Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=josholson_api;Password=${POSTGRES_API_PASSWORD}
# Lets /admin register the first passkey while none exists (ADR 0044). At least 32 characters; make one with `openssl rand -base64 32`.
# Leave it out and setup is off. It does nothing once a passkey exists.
Auth__SetupSecret=
