<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The seed tool's command line (ADR 0033): commands are classes, built on `Spectre.Console.Cli` and the DI container,
    over the library in `JoshOlson.Database`. Run it through `mise` (`mise run seeds:list`). Tests live next to the code as
    `*.Tests.cs`, as in `JoshOlson.Api`. `IncludeTests` defaults to on for `Debug` and off otherwise. Pass
    `-p:IncludeTests=true|false` to override. `Program.cs` hands a `dotnet test` run to the test runner, as the API's does.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IncludeTests Condition="'$(IncludeTests)' == ''">$([System.String]::Equals('$(Configuration)', 'Debug'))</IncludeTests>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**/*.Tests.cs" Condition="'$(IncludeTests)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../JoshOlson.Database/JoshOlson.Database.csproj" />
    <ProjectReference Include="../JoshOlson.Shared/JoshOlson.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IncludeTests)' == 'true'">
    <UseAppHost>true</UseAppHost>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <DefineConstants>$(DefineConstants);INCLUDE_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeTests)' == 'true'">
    <PackageReference Include="Spectre.Console.Testing" />
    <PackageReference Include="xunit.v3.mtp-v2" PrivateAssets="all" />
  </ItemGroup>

</Project>
